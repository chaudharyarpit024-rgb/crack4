# ==============================================================================
# CRACK BACKEND - RENDER ENVIRONMENT VARIABLES
# ==============================================================================
# Copy and paste these into your Render Web Service -> Environment tab.
# Replace the placeholder values with your actual production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., from MongoDB Atlas)
# Make sure to allow network access from 0.0.0.0/0 in MongoDB Atlas settings.
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crack?retryWrites=true&w=majority

# Database name
DB_NAME=crack

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Secret key for JWT signing.
# CRITICAL: Must be AT LEAST 32 characters long and not contain the word 'placeholder'
# Generate one with: openssl rand -hex 32
JWT_SECRET=your_32_plus_char_strong_random_secret_here

# ------------------------------------------------------------------------------
# 3. SERVICE URLS (Required)
# ------------------------------------------------------------------------------
# Your public backend service URL on Render (used for email verification links & callbacks)
PUBLIC_API_URL=https://<your-render-service-name>.onrender.com

# Deep link return URL for the mobile app after completing payment/subscription
MOBILE_RETURN_URL=crack://razorpay-complete

# Allowed CORS origins (comma-separated). Set your frontend domain(s) in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------------------------
# 4. AI & VISION MODEL INTEGRATION (Required for Meal Scanner)
# ------------------------------------------------------------------------------
# API Key for Gemini / Emergent AI vision analysis for food macros & calorie estimation
EMERGENT_LLM_KEY=your_gemini_or_emergent_api_key_here

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT & SUBSCRIPTIONS (Required for Subscriptions)
# ------------------------------------------------------------------------------
# Razorpay Key ID (rzp_live_... or rzp_test_...)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Webhooks -> /api/subscriptions/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay Plan ID for recurring subscriptions
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxxx

# Subscription charge amount in Paise (5700 paise = 57 INR)
SUBSCRIPTION_AMOUNT_PAISE=5700

# Length of free trial in days
SUBSCRIPTION_TRIAL_DAYS=10

# ------------------------------------------------------------------------------
# 6. EMAIL & VERIFICATION (Brevo or SMTP)
# ------------------------------------------------------------------------------
# In production, set to 0 to send real emails. Set to 1 for dry-run (logs email content only).
SMTP_DRY_RUN=0

# Brevo (Sendinblue) API Key (recommended on Render because it uses HTTPS Port 443)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Outgoing sender address
SMTP_FROM=no-reply@yourdomain.com

# Email verification link expiration in hours
EMAIL_VERIFY_TTL_HOURS=24

# Cooldown between resend verification requests in seconds
RESEND_MIN_INTERVAL_SECONDS=60

# Optional SMTP fallback (only needed if NOT using Brevo API key)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_email
SMTP_PASSWORD=your_smtp_password

# ------------------------------------------------------------------------------
# 7. UPTIMEROBOT AWAKENING CHECKPOINT (Optional)
# ------------------------------------------------------------------------------
# Secret key for the /api/awake endpoint. Pass this in the X-Wakeup-Key header in UptimeRobot.
WAKEUP_SECRET_KEY=your_random_wakeup_secret_key_here

